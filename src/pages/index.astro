---
import { site } from '../site';
---

<!doctype html>
<html lang="und">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, follow" />
		<title>{site.name}</title>
		<link rel="alternate" hreflang="en" href="https://www.d6e.ai/en-US/signkit" />
		<link rel="alternate" hreflang="ja" href="https://www.d6e.ai/ja-JP/signkit" />
		<script is:inline>
			const preferredLanguages = navigator.languages?.length
				? navigator.languages
				: [navigator.language];
			const locale =
				preferredLanguages
					.map((language) => language.toLowerCase().split('-')[0])
					.find((language) => language === 'en' || language === 'ja') ?? 'en';
			window.location.replace(
				locale === 'ja' ? 'https://www.d6e.ai/ja-JP/signkit' : 'https://www.d6e.ai/en-US/signkit',
			);
		</script>
	</head>
	<body>
		<nav aria-label="Language / 言語">
			<a href="https://www.d6e.ai/en-US/signkit" lang="en">
				English
			</a>
			<a href="https://www.d6e.ai/ja-JP/signkit" lang="ja">
				日本語
			</a>
		</nav>
	</body>
</html>
